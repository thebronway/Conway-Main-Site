---
const { status } = Astro.props;

const normalizedStatus = status ? status.toLowerCase() : 'concept';

const styles = {
  // 1. LIVE & SUPPORTED (Green)
  'live & supported': { 
    bg: 'rgba(16, 185, 129, 0.1)', 
    text: '#34d399',
    border: 'rgba(16, 185, 129, 0.2)',
    label: 'Live & Supported' 
  },
  // 2. ACTIVE DEVELOPMENT (Blue)
  'active development': { 
    bg: 'rgba(56, 189, 248, 0.1)', 
    text: '#38bdf8',
    border: 'rgba(56, 189, 248, 0.2)',
    label: 'Active Development' 
  },
  // 3. CONCEPT (Purple)
  'concept': { 
    bg: 'rgba(192, 132, 252, 0.1)', 
    text: '#c084fc',
    border: 'rgba(192, 132, 252, 0.2)',
    label: 'Concept' 
  },
  // 4. PAUSED & BACKLOG (Orange)
  'paused & backlog': { 
    bg: 'rgba(251, 146, 60, 0.1)',
    text: '#fb923c',
    border: 'rgba(251, 146, 60, 0.2)',
    label: 'Paused & Backlog' 
  },
  // 5. ARCHIVED (Slate)
  'archived': { 
    bg: 'rgba(148, 163, 184, 0.1)',
    text: '#94a3b8',
    border: 'rgba(148, 163, 184, 0.2)',
    label: 'Archived' 
  },
  // 6. HIDDEN (Slate)
  'hidden': { 
    bg: 'rgba(148, 163, 184, 0.1)',
    text: '#94a3b8',
    border: 'rgba(148, 163, 184, 0.2)',
    label: 'Hidden'
  }
};

// Fallback logic
const currentStyle = styles[normalizedStatus] || styles['concept'];
---

<span class="badge" style={`
  background: ${currentStyle.bg}; 
  color: ${currentStyle.text}; 
  border-color: ${currentStyle.border};
`}>
  <span class="dot" style={`background: ${currentStyle.text}`}></span>
  {currentStyle.label}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid;
    white-space: nowrap;
  }
  
  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
</style>