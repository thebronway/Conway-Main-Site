---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardProject from '../components/CardProject.astro';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

async function resolveVersion(gitUrl: string | undefined, versionField: string | undefined) {
  if (!versionField) return null;
  if (versionField !== 'fetch') return versionField;
  if (!gitUrl) return null;

  const match = gitUrl.match(/github\.com\/([^/]+)\/([^/]+)/);
  if (!match) return null;
  const [, owner, repo] = match;

  try {
    const rawUrl = `https://raw.githubusercontent.com/${owner}/${repo}/main/README.md`;
    const response = await fetch(rawUrl);
    if (!response.ok) return null;
    const text = await response.text();
    const versionMatch = text.match(/badge\/version-([v\d\.]+)-/i);
    return versionMatch ? versionMatch[1] : null;
  } catch (error) {
    console.error(`Error fetching version for ${repo}:`, error);
    return null;
  }
}

// Fetch projects
const rawProjects = await getCollection('projects');

const projects = await Promise.all(rawProjects.map(async (p) => ({
  ...p,
  data: { ...p.data, version: (await resolveVersion(p.data.gitUrl, p.data.version)) || undefined }
})));

// Filter out hidden and sort by manual override order, then alphabetically by title
const visibleProjects = projects
  .filter(p => p.data.status !== 'Hidden')
  .sort((a, b) => {
    const orderDiff = (a.data.order || 0) - (b.data.order || 0);
    if (orderDiff !== 0) return orderDiff;
    // Secondary sort: alphabetical by title if orders are tied
    return a.data.title.localeCompare(b.data.title);
  });

// Group into the 5 lifecycle buckets
const liveProjects = visibleProjects.filter(p => p.data.status === 'Live & Supported');
const activeProjects = visibleProjects.filter(p => p.data.status === 'Active Development');
const conceptProjects = visibleProjects.filter(p => p.data.status === 'Concept');
const pausedProjects = visibleProjects.filter(p => p.data.status === 'Paused & Backlog');
const archivedProjects = visibleProjects.filter(p => p.data.status === 'Archived');
---

<BaseLayout title="brian.conway.im" showNavbar={false}>
  <div class="home-nav">
    <div class="logo"><a href="/">brian.conway.im</a></div>
  </div>
  
  <section class="about-section">
    <h1>Hi, I'm Brian.</h1>
    <h2>And these are my side quests.</h2>
    <p class="bio">
      • I have a passion for designing and building things that make life a little more efficient and effective.<br/>
      • This hub showcases my solution architect skills, where I act as the technical authority and builder.<br/>
      • I own the design and execution from 0 to 1, leveraging AI to assist in bringing my ideas to life.
    </p>
     <p class="bio">Feel free to reach out.</p>
    
    <div class="links">
      <a href="/files/Conway_Resume.pdf" target="_blank" rel="noopener noreferrer" class="link-item hover-resume">
        <Icon name="tabler:file-text" class="icon" />
        Résumé
      </a>
      <a href="mailto:brian@conway.im" class="link-item hover-email">
        <Icon name="tabler:mail" class="icon" />
        brian@conway.im
      </a>
      <a href="https://github.com/thebronway" target="_blank" rel="noopener noreferrer" class="link-item hover-github">
        <Icon name="simple-icons:github" class="icon" />
        GitHub
      </a>
      <a href="https://hub.docker.com/u/thebronway" target="_blank" rel="noopener noreferrer" class="link-item hover-docker">
        <Icon name="simple-icons:docker" class="icon" />
        Dockerhub
      </a>
      <a href="https://buymeacoffee.com/brianconway" target="_blank" rel="noopener noreferrer" class="link-item hover-bmac">
        <Icon name="simple-icons:buymeacoffee" class="icon" />
        Support my work
      </a>
    </div>

  </section>

  {liveProjects.length > 0 && (
    <>
      <hr class="divider" />
      <section>
        <h2>Live & Supported</h2>
        <p class="section-desc">Polished, deployed solutions that I actively maintain.</p>
        <div class="grid">
          {liveProjects.map(p => <CardProject project={p} />)}
        </div>
      </section>
    </>
  )}

  {activeProjects.length > 0 && (
    <>
      <hr class="divider" />
      <section>
        <h2>Active Development</h2>
        <p class="section-desc">Projects currently in the pipeline and receiving regular commits.</p>
        <div class="grid">
          {activeProjects.map(p => <CardProject project={p} />)}
        </div>
      </section>
    </>
  )}

  {conceptProjects.length > 0 && (
    <>
      <hr class="divider" />
      <section>
        <h2>Drawing Board</h2>
        <p class="section-desc">The place for my ideas to grow. This is where I take shower thoughts and map out the early architecture, with the goal of one day bringing them to life.</p>
        <div class="grid">
          {conceptProjects.map(p => <CardProject project={p} />)}
        </div>
      </section>
    </>
  )}

  {pausedProjects.length > 0 && (
    <>
      <hr class="divider" />
      <section>
        <h2>Paused & Backlog</h2>
        <p class="section-desc">Foundational work temporarily on hold while I focus on other priorities.</p>
        <div class="grid">
          {pausedProjects.map(p => <CardProject project={p} />)}
        </div>
      </section>
    </>
  )}

  {archivedProjects.length > 0 && (
    <>
      <hr class="divider" />
      <section>
        <h2>The Vault</h2>
        <p class="section-desc">Retired or archived deliverables preserved for historical reference.</p>
        <div class="grid">
          {archivedProjects.map(p => <CardProject project={p} />)}
        </div>
      </section>
    </>
  )}

</BaseLayout>

<style>
  .home-nav {
    margin-bottom: 2.5rem;
  }
  .logo {
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.05em;
  }
  .logo a {
    color: var(--text-main);
    text-decoration: none;
    transition: color 0.2s;
  }
  .logo a:hover {
    color: var(--accent);
  }
  
  .about-section { margin-bottom: 3rem; margin-top: 0; }
  h1 { font-size: 3rem; margin-bottom: 1.5rem; line-height: 1; }
  .bio { font-size: 1.25rem; color: var(--text-muted); margin-bottom: 2rem; line-height: 1.6; max-width: none; }
  
  .links { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  
  .link-item { 
    display: flex;       /* Use flex to align icon and text */
    align-items: center; /* Vertically center them */
    gap: 0.5rem;         /* Space between icon and text */
    color: #fff; 
    font-weight: 600; 
    border-bottom: 1px solid transparent; 
    font-size: 1.1rem; 
    text-decoration: none; /* Remove default underline */
  }
  
  .link-item:hover { border-bottom-color: var(--accent); }

  .icon {
    width: 1.3rem; 
    height: 1.3rem;
    color: var(--text-muted);
    transition: color 0.2s ease;
  }

  /* Specific Hover Colors for each icon */
  .hover-resume:hover .icon { color: #10B981; } /* Emerald Green */
  .hover-email:hover .icon { color: #38bdf8; }  /* Theme Accent Blue */
  .hover-github:hover .icon { color: #a855f7; } /* Purple */
  .hover-docker:hover .icon { color: #2496ED; } /* Official Docker Blue */
  .hover-bmac:hover .icon { color: #FFDD00; }   /* Official BMC Yellow */

  .divider { margin: 4rem 0; border: 0; border-top: 1px solid var(--border); }
  
  h2 { margin-bottom: 0.5rem; font-size: 1.8rem; }
  .section-desc { color: var(--text-muted); font-size: 1.05rem; margin-bottom: 1.5rem; line-height: 1.5; }
  section:last-of-type { margin-bottom: 4rem; }
  
  .grid { 
    display: grid; 
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); 
    gap: 1.5rem; 
  }
  
</style>